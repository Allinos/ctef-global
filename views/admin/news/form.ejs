<%- include('../../partials/admin-head') %>
<%- include('../../partials/admin-nav', { section: 'news' }) %>

<h1 style="font-size:1.4rem"><%= item.id ? 'Edit news item' : 'New news item' %></h1>

<form class="admin-card admin-form" method="post" action="<%= item.id ? `/admin/news/${item.id}` : '/admin/news' %>">
  <div class="field">
    <label for="title">Title <span class="req">*</span></label>
    <input class="input" id="title" name="title" value="<%= item.title || '' %>" required>
    <% if (errors.title) { %><div class="err-msg"><%= errors.title %></div><% } %>
  </div>
  <div class="row2">
    <div class="field">
      <label for="category">Category <span class="req">*</span></label>
      <select class="input" id="category" name="category" required>
        <% ['Announcement','Circular','Award'].forEach(c => { %><option <%= item.category===c?'selected':'' %>><%= c %></option><% }) %>
      </select>
      <% if (errors.category) { %><div class="err-msg"><%= errors.category %></div><% } %>
    </div>
    <div class="field">
      <label for="published_date">Published date <span class="req">*</span></label>
      <input class="input" id="published_date" name="published_date" type="date" value="<%= item.published_date || '' %>" required>
      <% if (errors.published_date) { %><div class="err-msg"><%= errors.published_date %></div><% } %>
    </div>
  </div>
  <div class="field"><label for="body">Body</label><textarea class="input" id="body" name="body" style="min-height:100px"><%= item.body || '' %></textarea></div>
  <div class="field"><label for="link">Link (optional)</label><input class="input" id="link" name="link" value="<%= item.link || '' %>" placeholder="/events or https://..."></div>
  <div style="display:flex;gap:10px">
    <button class="btn" type="submit">Save news item</button>
    <a class="btn ghost" href="/admin/news">Cancel</a>
  </div>
</form>

<%- include('../../partials/admin-foot') %>
