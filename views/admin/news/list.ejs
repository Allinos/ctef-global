<%- include('../../partials/admin-head') %>
<%- include('../../partials/admin-nav', { section: 'news' }) %>

<div class="admin-toolbar">
  <h1 style="font-size:1.4rem;margin:0">News &amp; announcements</h1>
  <a class="btn" href="/admin/news/new">+ New news item</a>
</div>

<div class="admin-card" style="padding:0;overflow-x:auto">
  <table class="admin-table">
    <thead><tr><th>Title</th><th>Category</th><th>Date</th><th></th></tr></thead>
    <tbody>
      <% list.forEach(n => { %>
      <tr>
        <td><%= n.title %></td>
        <td><%= n.category %></td>
        <td><%= fmtDate(n.published_date) %></td>
        <td style="white-space:nowrap;display:flex;gap:8px">
          <a class="btn sm ghost" href="/admin/news/<%= n.id %>/edit">Edit</a>
          <form method="post" action="/admin/news/<%= n.id %>/delete" data-confirm="Delete this news item?">
            <button class="btn sm ghost" type="submit">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (!list.length) { %><tr><td colspan="4" class="muted" style="text-align:center;padding:24px">No news items yet.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../../partials/admin-foot') %>
