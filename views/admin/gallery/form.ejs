<%- include('../../partials/admin-head') %>
<%- include('../../partials/admin-nav', { section: 'gallery' }) %>

<h1 style="font-size:1.4rem"><%= image.id ? 'Edit photo' : 'New photo' %></h1>

<form class="admin-card admin-form" method="post" action="<%= image.id ? `/admin/gallery/${image.id}` : '/admin/gallery' %>" enctype="multipart/form-data">
  <div class="field">
    <label for="photo">Photo <% if (!image.id) { %><span class="req">*</span><% } %></label>
    <img class="current-image" src="<%= image.image || '' %>" alt="" id="currentImg" style="<%= image.image ? '' : 'display:none' %>">
    <input class="input" id="photo" name="image" type="file" accept="image/*" data-preview="#currentImg" <%= image.id ? '' : 'required' %>>
    <% if (errors.image) { %><div class="err-msg"><%= errors.image %></div><% } %>
  </div>
  <div class="field">
    <label for="caption">Caption <span class="req">*</span></label>
    <input class="input" id="caption" name="caption" value="<%= image.caption || '' %>" required>
    <% if (errors.caption) { %><div class="err-msg"><%= errors.caption %></div><% } %>
  </div>
  <div class="field">
    <label for="category">Category</label>
    <input class="input" id="category" name="category" value="<%= image.category || '' %>" placeholder="e.g. Workshops, Seminars, Conferences, Meetings">
  </div>
  <div class="field">
    <label for="sort_order">Sort order</label>
    <input class="input" id="sort_order" name="sort_order" type="number" value="<%= image.sort_order || 0 %>">
  </div>
  <div style="display:flex;gap:10px">
    <button class="btn" type="submit">Save photo</button>
    <a class="btn ghost" href="/admin/gallery">Cancel</a>
  </div>
</form>

<%- include('../../partials/admin-foot') %>
